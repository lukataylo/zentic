.DS_Store
.build/
.swiftpm/
*.xcuserstate
xcuserdata/
DerivedData/

node_modules/
web/.esbuild-meta.json

# The search index and its seeds are *built*, not authored: tens of megabytes of
# someone else's writing, regenerated by `npm run seed && npm run crawl`. Committing
# a crawl would also freeze a snapshot of other people's sites into this repo,
# which is not ours to redistribute.
search/data/

# Built app bundles
*.app/

# Filter list snapshots are fetched, not committed
Rules/downloaded/

# Never commit screenshots taken of a live desktop — they capture whatever else
# was on screen, which has already included an API key once.
# (docs/screenshot.png is committed deliberately; verify each one is browser-only)
