{
  "manifest_version": 3,
  "name": "Marker",
  "version": "1.0",
  "description": "A test extension: marks every page it runs on, counts them on its badge, and names the current tab in its popup.",
  "icons": { "48": "icon.png", "128": "icon.png" },
  "action": {
    "default_title": "Marker",
    "default_popup": "popup.html",
    "default_icon": { "32": "icon.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_end" }
  ],
  "permissions": ["tabs", "storage", "contextMenus"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" }
    }
  }
}
